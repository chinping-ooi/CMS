<div class="modal fade" id="taskItemModal" tabindex="-1" aria-labelledby="taskItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="taskItemModalLabel">Create New Task</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <style>
                                    .task-modal-grid {
                                        display: grid;
                                        grid-template-columns: repeat(2, minmax(0, 1fr));
                                        gap: 1.5rem;
                                        width: 100%;
                                        position: relative;
                                        align-items: stretch;
                                    }

                                    .task-modal-grid::before {
                                        content: '';
                                        position: absolute;
                                        top: 1.5rem;
                                        bottom: 1.5rem;
                                        left: 50%;
                                        width: 1px;
                                        background: #e9ecef;
                                        transform: translateX(-50%);
                                    }

                                    @@media (max-width: 991.98px) {
                                        .task-modal-grid {
                                            grid-template-columns: 1fr;
                                        }

                                        .task-modal-grid::before {
                                            display: none;
                                        }
                                    }

                                    .task-section {
                                        min-width: 0;
                                        padding: 0;
                                        border: none;
                                        background: transparent;
                                    }

                                    .task-section-inner {
                                        padding: 0;
                                        border: none;
                                        background: transparent;
                                        height: 100%;
                                        display: flex;
                                        flex-direction: column;
                                        gap: 1rem;
                                    }

                                    .task-label {
                                        display: block;
                                        font-size: 0.75rem;
                                        font-weight: 600;
                                        color: #6b7280;
                                        text-transform: uppercase;
                                        margin-bottom: 0.5rem;
                                    }

                    .task-description-wrapper {
                        display: flex;
                        flex-direction: column;
                        flex: 1 1 auto;
                        min-height: 0;
                    }

                    .task-description {
                        flex: 1 1 auto;
                        min-height: 0;
                        height: 100%;
                        resize: vertical;
                    }

                    .task-description-count {
                        margin-top: 0.35rem;
                        font-size: 0.8rem;
                        color: #6c757d;
                        text-align: right;
                    }

                    .readonly-input,
                    .readonly-select {
                        background-color: #f8fafc !important;
                        color: #495057;
                        padding-right: 2.5rem !important;
                        background-image: none !important;
                    }

                    .readonly-input-group {
                        position: relative;
                    }

                    .readonly-input-icon {
                        position: absolute;
                        right: 0.75rem;
                        top: 50%;
                        transform: translateY(-50%);
                        color: #6b7280;
                        font-size: 1rem;
                        pointer-events: none;
                    }

                    .readonly-select {
                        pointer-events: none;
                        cursor: not-allowed;
                        -webkit-appearance: none;
                        -moz-appearance: none;
                        appearance: none;
                        background-position: right 0.75rem center;
                        background-repeat: no-repeat;
                    }

                    .readonly-input:focus,
                    .readonly-select:focus {
                        box-shadow: none;
                    }

                    .task-attachment {
                        min-height: 100px;
                        border: 2px dashed #d1d5db;
                        border-radius: 0.75rem;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        gap: 0.35rem;
                        text-align: center;
                        color: #6b7280;
                        background: #f8fafc;
                        cursor: pointer;
                        padding: 0.75rem;
                        transition: border-color 0.2s ease, background-color 0.2s ease;
                    }

                    .task-attachment.drag-over {
                        border-color: #6c757d;
                        background-color: #e9ecef;
                    }

                    .task-attachment-list {
                        margin-top: 0.5rem;
                        display: flex;
                        flex-direction: column;
                        gap: 0.5rem;
                        width: 100%;
                    }

                    .task-attachment-item {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        gap: 0.5rem;
                        padding: 0.35rem 0.5rem;
                        border: 1px solid #dae1e7;
                        border-radius: 0.65rem;
                        background: #ffffff;
                        font-size: 0.9rem;
                    }

                    .task-attachment-item-name {
                        overflow: hidden;
                        text-overflow: ellipsis;
                        white-space: nowrap;
                        flex: 1 1 auto;
                        min-width: 0;
                        color: #212529;
                        font-size: 0.9rem;
                    }

                    .task-attachment-item-size {
                        flex-shrink: 0;
                        font-size: 0.75rem;
                        color: #6c757d;
                    }

                    .task-attachment-remove {
                        border: none;
                        background: transparent;
                        color: #6b7280;
                        width: 1.5rem;
                        height: 1.5rem;
                        border-radius: 999px;
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        cursor: pointer;
                        font-size: 1rem;
                        padding: 0;
                    }

                    .task-attachment-remove:hover {
                        background: transparent;
                    }
                </style>

                <form class="task-modal-grid" id="task-item-form">
                    <div class="task-section">
                        <div class="task-section-inner">
                            <div>
                                <label class="task-label" for="task-title">Task Name <span class="text-danger">*</span></label>
                                <input id="task-title" name="Title" class="form-control" required
                                       placeholder="EMPLOYEE-BUG-001" />
                            </div>

                            <div class="task-description-wrapper">
                                <label class="task-label" for="task-description">Description <span class="text-danger">*</span></label>
                                <textarea id="task-description" name="Description" class="form-control task-description"
                                          placeholder="Describe the task and acceptance criteria." maxlength="20000" required></textarea>
                                <div id="task-description-count" class="task-description-count">20,000 characters left...</div>
                            </div>
                        </div>
                    </div>

                    <div class="task-section">
                        <div class="task-section-inner">
                            <div class="d-grid gap-3"
                                 style="grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; display: grid;">
                                <div>
                                <label class="task-label" for="task-board-type">Board Type <span class="text-danger">*</span></label>
                                <div class="readonly-input-group">
                                    <input id="task-board-type" name="BoardType" class="form-control readonly-input" value=""
                                           readonly required />
                                    <i class="bi bi-lock-fill readonly-input-icon"></i>
                                </div>
                            </div>

                            <div>
                                <label class="task-label" for="task-column">Column <span class="text-danger">*</span></label>
                                <div class="readonly-input-group">
                                    <select id="task-column" name="ColumnId" class="form-select" required></select>
                                </div>
                            </div>

                                <div>
                                    <label class="task-label" for="task-start-date">Start Date <span class="text-danger">*</span></label>
                                    <input id="task-start-date" name="StartDate" type="date" class="form-control" required />
                                </div>

                                <div>
                                    <label class="task-label" for="task-due-date">Due Date <span class="text-danger">*</span></label>
                                    <input id="task-due-date" name="DueDate" type="date" class="form-control" required />
                                </div>
                            </div>

                            <div>
                                <label class="task-label" for="task-assigned-to">Assigned To</label>
                                <select id="task-assigned-to" name="AssignedUserIds" class="form-select" multiple size="4">
                                </select>
                                <div class="form-text">Hold Ctrl (Windows) or Cmd (Mac) to select multiple users.</div>
                            </div>

                            <div class="d-grid gap-3"
                                 style="grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; display: grid;">
                                <div>
                                    <label class="task-label" for="task-priority">Priority <span class="text-danger">*</span></label>
                                    <select id="task-priority" name="Priority" class="form-select" required>
                                        <option value="">-- Please Select --</option>
                                        <option value="Low">Low</option>
                                        <option value="Medium" selected>Medium</option>
                                        <option value="High">High</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="task-label" for="task-category">Category</label>
                                    <select id="task-category" name="TagId" class="form-select">
                                        <option value="">-- Please Select --</option>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label class="task-label">Attachments</label>
                                <div class="task-attachment" id="task-attachment-dropzone">
                                    <div>Drop files here</div>
                                    <div class="form-text text-muted mb-0">Up to 5MB per file. Click to add attachments.</div>
                                </div>
                                <input id="task-attachment-input" type="file" class="d-none" multiple />
                                <div id="task-attachment-list" class="task-attachment-list"></div>
                            </div>
                        </div>
                    </div>
                </form>
                <script>
                    (function() {
                        const textarea = document.getElementById('task-description');
                        const counter = document.getElementById('task-description-count');
                        if (!textarea || !counter) {
                            return;
                        }

                        const maxLen = Number(textarea.getAttribute('maxlength') || 0);
                        if (!maxLen) {
                            return;
                        }

                        const updateCounter = () => {
                            const left = Math.max(0, maxLen - textarea.value.length);
                            const plural = left === 1 ? 'character' : 'characters';
                            counter.textContent = `${left.toLocaleString()} ${plural} left...`;
                        };

                        textarea.addEventListener('input', updateCounter);
                        updateCounter();

                        const dropzone = document.getElementById('task-attachment-dropzone');
                        const fileInput = document.getElementById('task-attachment-input');
                        const attachmentList = document.getElementById('task-attachment-list');
                        const maxSize = 5 * 1024 * 1024;
                        const attachments = [];

                        const formatFileSize = (size) => {
                            return size < 1024
                                ? `${size} B`
                                : size < 1024 * 1024
                                    ? `${(size / 1024).toFixed(1)} KB`
                                    : `${(size / (1024 * 1024)).toFixed(1)} MB`;
                        };

                        const renderAttachments = () => {
                            if (!attachmentList) return;
                            attachmentList.innerHTML = '';

                            attachments.forEach((file, index) => {
                                const item = document.createElement('div');
                                item.className = 'task-attachment-item';

                                const name = document.createElement('div');
                                name.className = 'task-attachment-item-name';
                                name.textContent = file.name;

                                const fileSize = document.createElement('div');
                                fileSize.className = 'task-attachment-item-size';
                                fileSize.textContent = formatFileSize(file.size);

                                const removeButton = document.createElement('button');
                                removeButton.type = 'button';
                                removeButton.className = 'task-attachment-remove';
                                removeButton.textContent = '×';
                                removeButton.addEventListener('click', function () {
                                    attachments.splice(index, 1);
                                    renderAttachments();
                                });

                                item.appendChild(name);
                                item.appendChild(fileSize);
                                item.appendChild(removeButton);
                                attachmentList.appendChild(item);
                            });
                        };

                        const addFiles = (files) => {
                            Array.from(files).forEach((file) => {
                                if (file.size <= maxSize) {
                                    attachments.push(file);
                                }
                            });
                            renderAttachments();
                        };

                        if (dropzone && fileInput) {
                            dropzone.addEventListener('click', function () {
                                fileInput.click();
                            });

                            dropzone.addEventListener('dragover', function (event) {
                                event.preventDefault();
                                dropzone.classList.add('drag-over');
                            });

                            dropzone.addEventListener('dragleave', function () {
                                dropzone.classList.remove('drag-over');
                            });

                            dropzone.addEventListener('drop', function (event) {
                                event.preventDefault();
                                dropzone.classList.remove('drag-over');
                                if (!event.dataTransfer) return;
                                addFiles(event.dataTransfer.files);
                            });

                            fileInput.addEventListener('change', function () {
                                if (!fileInput.files) return;
                                addFiles(fileInput.files);
                                fileInput.value = '';
                            });
                        }
                    })();
                </script>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-cancel px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-action px-4" id="save-task-button">Create Task</button>
            </div>
        </div>
    </div>
</div>
