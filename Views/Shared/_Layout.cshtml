<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMS</title>
    <script type="importmap"></script>
    <script>
        // Prevent sidebar flash: apply collapsed state from localStorage
        try {
        if (localStorage.getItem('cms.sidebar.collapsed') === '1') {
        document.documentElement.classList.add('sidebar-collapsed');
        }
        } catch (e) { }
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CMS.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var displayName = User.Identity?.Name;
    var avatarInitial = string.IsNullOrWhiteSpace(displayName)
        ? "?"
        : displayName[..1].ToUpperInvariant();
}

<body class="bg-light">
    <div class="container-fluid px-0">
        <header class="bg-white border-bottom py-3 px-4 w-100">
            <div class="d-flex align-items-center justify-content-between w-100">
                <div class="d-flex align-items-center gap-3">
                    <button id="sidebarToggle" class="btn btn-light btn-sm d-md-inline-flex d-none"
                            aria-label="Toggle sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <a id="brandLink" class="d-flex align-items-center text-decoration-none text-dark"
                       asp-controller="Home" asp-action="Index">
                        <i class="fa fa-kanban-fill2"></i>
                        <span class="fs-5 fw-bold d-none d-md-inline">CMS CRM</span>
                    </a>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-light btn-sm rounded-circle" aria-label="Notifications">
                        <i class="fa fa-bell"></i>
                    </button>
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-semibold"
                          style="width: 2rem; height: 2rem;"
                          title="@displayName"
                          aria-label="@displayName">
                        @avatarInitial
                    </span>
                    <button id="logoutButton" type="button" class="btn btn-light btn-sm rounded-circle" aria-label="Log out" title="Log out">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </div>
            </div>
        </header>

        <div class="row g-0 min-vh-100">
            <aside class="col-auto bg-white border-end sidebar">
                <div class="p-3">
                    @{
                        var menu = new[] {
                            new { Controller = "Customer", Action = "Index", Icon = "fa fa-users", Label = "Customers" },
                            new { Controller = "Task", Action = "Index", Icon = "fa fa-tasks", Label = "Tasks" }
                        };
                    }
                    <ul class="nav nav-pills flex-column gap-1">
                        @foreach (var item in menu)
                        {
                            <li class="nav-item">
                                <a class="nav-link rounded @(currentController == item.Controller ? "active" : "")"
                                   asp-controller="@item.Controller" asp-action="@item.Action">
                                    <i class="@item.Icon icon"></i><span class="label ms-2">@item.Label</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </aside>

            <div class="col d-flex flex-column">
                <main role="main" class="flex-grow-1 bg-light p-4">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    @if (TempData["ToastMessage"] != null)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
            <div id="liveToast" class="toast border border-@TempData["ToastType"]-subtle bg-@TempData["ToastType"]-subtle"
                 role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
                <div class="toast-header bg-transparent border-@TempData["ToastType"]-subtle">
                    <strong class="me-auto">Notification</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
                <div class="toast-body">
                    @TempData["ToastMessage"]
                </div>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
            var toast = new bootstrap.Toast(document.getElementById("liveToast"));
            toast.show();
            });
        </script>
    }

    <div class="modal fade" id="globalConfirmModal" tabindex="-1" aria-labelledby="globalConfirmModalTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0">
                <div class="modal-header">
                    <h5 class="modal-title text-capitalize" id="globalConfirmModalTitle">Confirm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="globalConfirmModalMessage"></div>
                <div class="modal-footer justify-content-end">
                    <button type="button" class="btn btn-cancel px-4 fw-semibold"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="globalConfirmModalOk"
                            class="btn btn-delete px-4 fw-semibold">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="globalErrorModal" tabindex="-1" aria-labelledby="globalErrorModalTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border border-danger-subtle shadow-sm bg-danger-subtle">
                <div class="modal-header">
                    <h4 class="modal-title fw-bold text-uppercase text-danger" id="globalErrorModalTitle">Error</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2 fw-semibold text-danger" id="globalErrorModalMessage">Something went wrong.</p>
                    <p class="text-danger-emphasis small mb-0" id="globalErrorModalDetail">Please try again.</p>
                </div>
                <div class="modal-footer justify-content-end">
                    <button type="button" class="btn btn-sm btn-danger px-4 fw-semibold"
                            data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('logoutButton')?.addEventListener('click', async () => {
            try {
                await fetch('/api/auth/logout', { method: 'POST' });
            } finally {
                window.location.assign('/login');
            }
        });

        (function () {
        var confirmModalEl = document.getElementById('globalConfirmModal');
        var confirmModal = new bootstrap.Modal(confirmModalEl);
        var confirmOk = document.getElementById('globalConfirmModalOk');
        var confirmTitle = document.getElementById('globalConfirmModalTitle');
        var confirmMessage = document.getElementById('globalConfirmModalMessage');
        var confirmResolve = null;
        var errorModalEl = document.getElementById('globalErrorModal');
        var errorModal = new bootstrap.Modal(errorModalEl);
        var errorTitle = document.getElementById('globalErrorModalTitle');
        var errorMessage = document.getElementById('globalErrorModalMessage');
        var errorDetail = document.getElementById('globalErrorModalDetail');

        confirmOk.addEventListener('click', function () {
        if (confirmResolve) {
        confirmResolve(true);
        confirmResolve = null;
        }
        confirmModal.hide();
        });

        confirmModalEl.addEventListener('hidden.bs.modal', function () {
        if (confirmResolve) {
        confirmResolve(false);
        confirmResolve = null;
        }
        });

        window.showConfirm = function (options) {
        options = options || {};
        confirmTitle.textContent = options.title || 'Confirm';
        confirmMessage.textContent = options.message || 'Are you sure?';
        confirmOk.textContent = options.confirmText || 'Confirm';
        confirmModal.show();
        return new Promise(function (resolve) {
        confirmResolve = resolve;
        });
        };

        window.showError = function (options) {
        options = options || {};
        errorTitle.textContent = options.title || 'Error';
        errorMessage.textContent = options.message || 'Something went wrong.';
        errorDetail.textContent = options.detail || 'Please try again.';
        errorModal.show();
        };
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
