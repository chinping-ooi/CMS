@model CMS.Models.Project?

@{
    ViewData["Title"] = Model?.Name ?? "Tasks";
    var projectCreateModalModel = new Project();
    projectCreateModalModel.Columns.Add(new ProjectColumn { Name = "TO DO", Position = 0 });
    projectCreateModalModel.Columns.Add(new ProjectColumn { Name = "IN PROGRESS", Position = 1 });
    projectCreateModalModel.Columns.Add(new ProjectColumn { Name = "PENDING REVIEW", Position = 2 });
    projectCreateModalModel.Columns.Add(new ProjectColumn { Name = "PENDING TO DEPLOY", Position = 3 });
    projectCreateModalModel.Columns.Add(new ProjectColumn { Name = "COMPLETED", Position = 4 });
    projectCreateModalModel.Tags.Add(new ProjectTag { Name = "FEATURE", Color = "#0d6efd" });
    projectCreateModalModel.Tags.Add(new ProjectTag { Name = "BUG", Color = "#dc3545" });
    projectCreateModalModel.Tags.Add(new ProjectTag { Name = "REQUEST", Color = "#198754" });
}

<style>
    .kb-topbar {
        background: #fff;
    }

    .kb-search {
        width: 260px;
    }

    .kb-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        object-fit: cover;
    }

    .kb-btn-primary {
        background: #2f6fed;
        color: #fff;
        border: none;
        font-weight: 500;
    }

    .kb-btn-primary:hover {
        background: #1c56d3;
        color: #fff;
    }

    .kb-btn-light {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
    }

    .kb-board {
        display: flex;
        gap: 20px;
        overflow-x: auto;
    }

    .kb-column {
        min-width: 300px;
        background: #ffffff;
        border: 1px solid #dbe2ea;
        padding: 12px;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    .kb-add-column {
        min-width: 300px;
        height: fit-content;
        padding: 12px;
        border: 1px dashed #aeb9c8;
        background: #f8fafc;
    }

    .kb-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .kb-title {
        font-weight: 700;
        font-size: 15px;
    }

    .kb-title-input {
        font-weight: 700;
        font-size: 15px;
        padding: 0;
        border: none;
        background: transparent;
        width: auto;
        max-width: 180px;
    }
    .kb-title-input:focus {
        outline: none;
        box-shadow: none;
        border-bottom: 1px solid rgba(47,111,237,0.6);
        background: #fff;
    }

    .kb-count {
        background: #edf1f7;
        color: #777;
        padding: 2px 8px;
        font-size: 12px;
        border: 1px solid #dbe2ea;
    }

    .kb-add-task {
        background: #fff;
        border: 2px dashed #d8d8d8;
        padding: 12px;
        color: #777;
        cursor: pointer;
        transition: .2s;
        margin-bottom: 15px;
    }

    .kb-add-task:hover {
        background: #f8f9fa;
    }

    .kb-card {
        background: #fff;
        padding: 15px;
        border: 1px solid #e5e7eb;
    }

    .kb-card-dropdown {
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .kb-card-dropdown .btn {
        color: #6c757d;
        font-size: 1rem;
        line-height: 1;
        padding: 0;
        min-width: 0;
        border: none;
        background: transparent;
    }

    .kb-card-dropdown .btn::after {
        display: none !important;
    }

    .kb-card-dropdown .dropdown-menu {
        min-width: 170px;
        padding: 0.3rem;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
    }

    .kb-card-dropdown .dropdown-item {
        border-radius: 6px;
        padding: 0.45rem 0.6rem;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .kb-card-dropdown .dropdown-item:hover {
        background: #f3f6ff;
        color: #1c56d3;
    }

    .kb-column.drag-over {
        background: #f8f9fa;
        border-color: #2f6fed;
        box-shadow: 0 0 0 1px rgba(47, 111, 237, 0.15), 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    .kb-column.column-dragging {
        opacity: 0.5;
    }

    .kb-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        min-height: 1.5rem;
    }

    .kb-task-tag {
        display: inline-flex;
        align-items: center;
        max-width: 100%;
        padding: 0.2rem 0.45rem;
        border: 1px solid var(--tag-color);
        border-radius: 0.35rem;
        background: color-mix(in srgb, var(--tag-color) 18%, white 82%);
        color: #374151;
        font-size: 0.72rem;
        font-weight: 600;
        line-height: 1.1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .kb-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #999;
        font-size: 13px;
    }

    .kb-reset-button {
        font-size: 0.75rem;
        padding: 0.2rem 0.45rem;
        min-width: auto;
        line-height: 1.1;
    }

    .kb-project-description {
        color: #6b7280;
        margin-bottom: 10px;
    }

    .kb-project-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .kb-project-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        font-size: 12px;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .kb-project-tag {
        background: color-mix(in srgb, var(--tag-color) 20%, white 80%);
        color: #374151;
        border: 1px solid var(--tag-color);
        box-shadow: none;
    }

    .kb-project-tag:hover,
    .kb-project-tag.active {
        transform: none;
    }

    .kb-project-tag-close {
        width: 1rem;
        height: 1rem;
        border: none;
        background: transparent;
        color: #4b5563;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0.75;
    }

    .kb-project-tag-close:hover {
        opacity: 1;
    }

    .kb-project-tag-close .bi {
        font-size: 0.95rem;
    }

    .invite-search-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        background: #fff;
        border-radius: .375rem;
        max-height: 260px;
        overflow-y: auto;
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.1);
    }

    .invite-search-dropdown .list-group-item {
        cursor: pointer;
    }

    .invite-search-dropdown .list-group-item.disabled {
        cursor: default;
        opacity: .65;
    }

    .kb-project-selector {
        min-width: 170px;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        background: #fff;
        color: #111827;
        font-weight: 500;
        padding: 0.45rem 0.7rem;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-align: left;
    }

    .kb-project-selector:hover,
    .kb-project-selector:focus {
        background: #fff;
        color: #111827;
        border-color: #2f6fed;
        box-shadow: 0 0 0 0.2rem rgba(47, 111, 237, 0.15);
    }

    .kb-project-selector-menu {
        min-width: 170px;
        padding: 0.3rem;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
    }

    .kb-project-selector-menu .dropdown-item {
        border-radius: 6px;
        padding: 0.45rem 0.6rem;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .kb-project-selector-menu .dropdown-item:hover {
        background: #f3f6ff;
        color: #1c56d3;
    }

    #filter-button.kb-project-selector {
        min-width: auto;
        width: fit-content;
    }

    .kb-owner-avatar,
    .kb-assignee-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        border: 2px solid #fff;
        border-radius: 50%;
        background: #e8f0ff;
        color: #1c56d3;
        font-size: 0.7rem;
        font-weight: 700;
        line-height: 1;
    }

    .kb-owner-avatar {
        width: 2.5rem;
        height: 2.5rem;
    }

    .kb-assignee-group {
        display: inline-flex;
        align-items: center;
        padding-left: 0.3rem;
    }

    .kb-assignee-avatar {
        width: 1.7rem;
        height: 1.7rem;
        margin-left: -0.5rem;
    }

    .kb-assignee-avatar:first-child {
        margin-left: 0;
    }

    .kb-assignee-avatar.is-overflow {
        background: #334155;
        color: #fff;
    }

    .kb-selector-dropdown-title {
        padding: 0 0.55rem;
        font-size: 0.9rem;
    }

    .kb-filter-checkbox {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.35rem 0.5rem;
        border-radius: 8px;
        background: #f8fafc;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .kb-filter-checkbox:hover {
        background: #eef2ff;
    }

    .kb-filter-checkbox-input {
        width: 1rem;
        height: 1rem;
        margin: 0;
    }

    .kb-filter-checkbox-label {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 500;
    }
</style>

@if (Model == null)
{
    <div class="container py-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h3 class="mb-3">No projects yet</h3>
                <p class="mb-4 text-muted">Create your first project to start managing tasks.</p>
                <button type="button" class="btn btn-primary" onclick="showCreateProjectModal()">Create First Project</button>
            </div>
        </div>
    </div>
}
else
{
    <div class="kb-topbar mb-3 p-3 border rounded">
        <div class="container-fluid px-0">
            <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="btn kb-project-selector dropdown-toggle" id="project-name-display" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span>@Model.Name</span>
                    </button>
                    <ul class="dropdown-menu kb-project-selector-menu" id="project-dropdown-menu" aria-labelledby="project-name-display"></ul>
                </div>

                <button class="btn btn-delete" type="button" id="delete-project-button">
                    <i class="bi bi-trash"></i>
                </button>

                <button class="btn btn-action" type="button" id="new-project-button">
                    <i class="bi bi-plus-lg"></i>
                    New Project
                </button>
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="input-group kb-search">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search"></i>
                    </span>
                    <input id="task-search-input" type="search" class="form-control" placeholder="Search task titles..." aria-label="Search task titles" autocomplete="off">
                </div>

                <div class="dropdown">
                    <button class="btn kb-project-selector dropdown-toggle" type="button" id="filter-button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <span><i class="bi bi-funnel"></i> Filter</span>
                    </button>
                    <div class="dropdown-menu kb-project-selector-menu" id="tag-filter-dropdown" aria-labelledby="filter-button" style="min-width: 170px;">
                        <div class="d-flex align-items-center justify-content-between kb-selector-dropdown-title mb-2">
                            <span class="fw-semibold">Filter by tags</span>
                            <button type="button" class="btn btn-outline-secondary kb-reset-button" id="clear-tag-filter-button">Clear</button>
                        </div>
                        <div id="tag-filter-list" class="d-flex flex-column gap-2"></div>
                    </div>
                </div>

                <button class="btn btn-action" type="button" id="invite-button">
                    <i class="bi bi-person-plus"></i>
                    Invite
                </button>
                <span id="project-owner-avatar" class="kb-owner-avatar border" title="Project owner" aria-label="Project owner">?</span>
            </div>
        </div>
    </div>
</div>

<div class="mb-3">
    <p class="kb-project-description" id="project-description">
        @(!string.IsNullOrWhiteSpace(Model.Description) ? Model.Description : string.Empty)
    </p>

    <div class="kb-project-meta" id="project-meta">
        @foreach (var tag in Model.Tags)
        {
            <span class="kb-project-tag rounded" style="--tag-color: @(tag.Color ?? "#6f42c1")" data-tag-id="@tag.Id">
                <i class="bi bi-tag"></i>@tag.Name
            </span>
        }
    </div>
</div>

<div class="kb-board mb-3" id="project-board" data-project-id="@Model.Id">
    @for (var index = 0; index < Model.Columns.Count; index++)
    {
        var column = Model.Columns.ElementAt(index);
        var tasks = Model.Tasks.Where(task => task.ColumnId == column.Id).ToList();

        <div class="kb-column rounded-3" data-column-id="@column.Id">
            <div class="kb-header" data-column-id="@column.Id">
                <div class="d-flex align-items-center gap-2">
                    <input type="text" class="kb-title-input" value="@column.Name" disabled aria-label="Column name">
                    <span class="kb-count rounded">@tasks.Count</span>
                </div>
                <div class="dropdown kb-column-dropdown">
                    <button class="btn p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end kb-project-selector-menu">
                        <li><button class="dropdown-item column-action-edit" type="button" data-column-id="@column.Id" data-column-name="@column.Name">Edit Name</button></li>
                        <li><button class="dropdown-item text-danger column-action-remove" type="button" data-column-id="@column.Id" data-column-name="@column.Name">Delete</button></li>
                    </ul>
                </div>
            </div>

            <div class="kb-add-task rounded" role="button" onclick="showTaskItemModal()">
                <i class="bi bi-plus-square me-2"></i>Add new task
            </div>

            @foreach (var task in tasks)
            {
                <div class="kb-card rounded mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="kb-card-tags"></div>
                        <div class="dropdown kb-card-dropdown">
                            <button class="btn p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end kb-project-selector-menu">
                                <li><button class="dropdown-item" type="button">View</button></li>
                                <li><button class="dropdown-item text-danger" type="button">Delete</button></li>
                            </ul>
                        </div>
                    </div>
                    <h6 class="mt-3 fw-bold">@task.Title</h6>
                    <div class="kb-card-footer mt-4">
                        <span>
                            <i class="bi bi-calendar3"></i>
                            @(task.DueDate?.ToString("yyyy-MM-dd") ?? "No date")
                        </span>
                        <i class="bi bi-person-circle fs-5"></i>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="deleteProjectModal" tabindex="-1" aria-labelledby="deleteProjectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteProjectModalLabel">Delete project</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this project? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirm-delete-project-button">Delete</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteTaskModal" tabindex="-1" aria-labelledby="deleteTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteTaskModalLabel">Delete task</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="delete-task-body">
                Are you sure you want to delete this task?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirm-delete-task-button">Delete</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteColumnModal" tabindex="-1" aria-labelledby="deleteColumnModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteColumnModalLabel">Delete column</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="delete-column-body">
                Are you sure you want to delete this column and all its tasks?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirm-delete-column-button">Delete</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="inviteCollaboratorModal" tabindex="-1" aria-labelledby="inviteCollaboratorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="inviteCollaboratorModalLabel">Invite Collaborator</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="position-relative">
                    <label for="invite-user-search" class="form-label">User email or name</label>
                    <input type="text" id="invite-user-search" class="form-control" placeholder="Search users..." autocomplete="off">
                    <div id="invite-user-results" class="list-group invite-search-dropdown" hidden></div>
                </div>
                <div class="mb-3">
                    <div id="selected-collaborators" class="d-flex flex-wrap gap-2"></div>
                </div>
                <div class="mb-3">
                    <div class="fw-semibold mb-2">Existing collaborators</div>
                    <div id="existing-collaborators-list" class="list-group"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-action px-4" id="invite-submit-button">Submit</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="inviteConfirmModal" tabindex="-1" aria-labelledby="inviteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="inviteConfirmModalLabel">Confirm invitation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="invite-confirm-body">
                Are you sure you want to invite the selected collaborators?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Back</button>
                <button type="button" class="btn btn-primary" id="confirm-invite-button">Confirm</button>
            </div>
        </div>
    </div>
</div>
}

@await Html.PartialAsync("_CreateProjectModal", projectCreateModalModel)
@await Html.PartialAsync("_TaskItemModal")

<script>
    const boardContainer = document.getElementById('project-board');
    const projectNameDisplay = document.getElementById('project-name-display');
    const projectDescription = document.getElementById('project-description');
    const projectMeta = document.getElementById('project-meta');
    const projectOwnerAvatar = document.getElementById('project-owner-avatar');
    const tagFilterList = document.getElementById('tag-filter-list');
    const clearTagFilterButton = document.getElementById('clear-tag-filter-button');
    const taskSearchInput = document.getElementById('task-search-input');
    const filterButton = document.getElementById('filter-button');
    const deleteProjectButton = document.getElementById('delete-project-button');
    const newProjectButton = document.getElementById('new-project-button');
    const inviteButton = document.getElementById('invite-button');
    const deleteProjectModal = document.getElementById('deleteProjectModal');
    const confirmDeleteProjectButton = document.getElementById('confirm-delete-project-button');
    const deleteTaskModal = document.getElementById('deleteTaskModal');
    const confirmDeleteTaskButton = document.getElementById('confirm-delete-task-button');
    const deleteTaskBody = document.getElementById('delete-task-body');
    const deleteColumnModal = document.getElementById('deleteColumnModal');
    const confirmDeleteColumnButton = document.getElementById('confirm-delete-column-button');
    const deleteColumnBody = document.getElementById('delete-column-body');
    const inviteCollaboratorModal = document.getElementById('inviteCollaboratorModal');
    const inviteUserSearch = document.getElementById('invite-user-search');
    const inviteUserResults = document.getElementById('invite-user-results');
    const selectedCollaboratorsContainer = document.getElementById('selected-collaborators');
    const inviteSubmitButton = document.getElementById('invite-submit-button');
    const confirmInviteButton = document.getElementById('confirm-invite-button');
    const inviteConfirmModal = document.getElementById('inviteConfirmModal');
    const inviteConfirmBody = document.getElementById('invite-confirm-body');
    const existingCollaboratorsList = document.getElementById('existing-collaborators-list');
    const projectDropdownMenu = document.getElementById('project-dropdown-menu');
    const projectModalElement = document.getElementById('projectModal');
    const taskItemModalElement = document.getElementById('taskItemModal');
    const taskTitleInput = document.getElementById('task-title');
    const taskDescriptionInput = document.getElementById('task-description');
    const taskBoardTypeInput = document.getElementById('task-board-type');
    const taskColumnSelect = document.getElementById('task-column');
    const taskStartDateInput = document.getElementById('task-start-date');
    const taskDueDateInput = document.getElementById('task-due-date');
    const taskAssignedToSelect = document.getElementById('task-assigned-to');
    const taskPrioritySelect = document.getElementById('task-priority');
    const taskCategorySelect = document.getElementById('task-category');
    const saveTaskButton = document.getElementById('save-task-button');

    let projectData = null;
    let selectedTagIds = new Set();
    let existingCollaboratorIds = new Set();
    let searchTerm = '';
    let projectDropdownLoaded = false;
    let tagSelectionInitialized = false;
    let pendingDeleteTaskId = null;
    const columnDragCounters = new WeakMap();

    function clearColumnDragState() {
        document.querySelectorAll('.kb-column.drag-over').forEach(element => {
            element.classList.remove('drag-over');
            columnDragCounters.set(element, 0);
        });
    }

    function setActiveDropColumn(activeColumnElement) {
        clearColumnDragState();
        if (activeColumnElement) {
            columnDragCounters.set(activeColumnElement, 1);
            activeColumnElement.classList.add('drag-over');
        }
    }

    async function loadProjectData() {
        if (!boardContainer) {
            return;
        }

        const projectId = boardContainer.dataset.projectId;
        try {
            const response = await fetch(`/api/projects/${projectId}`);
            if (!response.ok) {
                throw new Error('Unable to load project data');
            }

            projectData = await response.json();
            renderProject(projectData);
        } catch (error) {
            console.error(error);
        }
    }

    function renderProject(project) {
        existingCollaboratorIds = new Set((project.collaborators || []).map(collaborator => String(collaborator.userId).toLowerCase()));

        if (projectNameDisplay) {
            projectNameDisplay.textContent = project.name || 'Project';
        }

        if (projectDescription) {
            projectDescription.textContent = project.description || '';
        }

        renderProjectOwner(project);

        if (projectMeta) {
            projectMeta.innerHTML = '';

            if (!tagSelectionInitialized && !selectedTagIds.size && (project.tags || []).length) {
                selectedTagIds = new Set((project.tags || []).map(tag => tag.id));
                tagSelectionInitialized = true;
            }

            (project.tags || []).forEach(tag => {
                if (!selectedTagIds.has(tag.id)) {
                    return;
                }

                const badge = document.createElement('span');
                badge.className = 'kb-project-tag rounded';
                badge.style.setProperty('--tag-color', tag.color || '#6f42c1');
                badge.dataset.tagId = tag.id;
                badge.innerHTML = `
                    <i class="bi bi-tag"></i>
                    <span>${tag.name}</span>
                `;

                const closeBtn = document.createElement('button');
                closeBtn.type = 'button';
                closeBtn.className = 'kb-project-tag-close';
                closeBtn.innerHTML = '<i class="bi bi-x-lg"></i>';
                closeBtn.addEventListener('click', event => {
                    event.stopPropagation();
                    selectedTagIds.delete(tag.id);
                    updateTaskBoard();
                    renderTagFilterMenu(project.tags || []);
                    renderProject(project);
                });

                badge.appendChild(closeBtn);
                badge.addEventListener('click', () => {
                    if (selectedTagIds.has(tag.id)) {
                        selectedTagIds.delete(tag.id);
                    } else {
                        selectedTagIds.add(tag.id);
                    }
                    updateTaskBoard();
                    renderTagFilterMenu(project.tags || []);
                    renderProject(project);
                });

                badge.classList.toggle('active', selectedTagIds.has(tag.id));
                projectMeta.appendChild(badge);
            });
        }

        renderTagFilterMenu(project.tags || []);
        updateTaskBoard();
    }

    function getFilteredTasks() {
        const tasks = projectData?.tasks || [];
        const allTagsSelected = projectData?.tags && selectedTagIds.size === projectData.tags.length;
        return tasks.filter(task => {
            const matchesSearch = !searchTerm || String(task.title || '').toLocaleLowerCase().includes(searchTerm);
            const taskTags = task.tags || [];
            const matchesTag = selectedTagIds.size === 0
                || allTagsSelected
                || taskTags.some(tag => selectedTagIds.has(tag.id));
            return matchesSearch && matchesTag;
        });
    }

    function renderTagFilterMenu(tags) {
        if (!tagFilterList) {
            return;
        }

        tagFilterList.innerHTML = '';

        tags.forEach(tag => {
            const item = document.createElement('label');
            item.className = 'kb-filter-checkbox';
            item.htmlFor = `tag-filter-${tag.id}`;
            item.innerHTML = `
                <input class="kb-filter-checkbox-input" type="checkbox" value="${tag.id}" id="tag-filter-${tag.id}" ${selectedTagIds.has(tag.id) ? 'checked' : ''}>
                <span class="kb-filter-checkbox-label">${tag.name}</span>
            `;
            const checkbox = item.querySelector('input');
            checkbox.addEventListener('change', () => {
                if (checkbox.checked) {
                    selectedTagIds.add(tag.id);
                } else {
                    selectedTagIds.delete(tag.id);
                }
                updateTaskBoard();
                renderProject(projectData);
            });
            tagFilterList.appendChild(item);
        });
    }

    function updateTagBadges() {
        const badges = document.querySelectorAll('.kb-project-tag');
        badges.forEach(badge => {
            const tagId = Number(badge.dataset.tagId);
            badge.classList.toggle('active', selectedTagIds.has(tagId));
        });
    }

    function escapeHtml(value) {
        const element = document.createElement('div');
        element.textContent = value || '';
        return element.innerHTML;
    }

    function getInitials(name) {
        return (name || '?')
            .trim()
            .split(/\s+/)
            .filter(Boolean)
            .map(part => part.charAt(0))
            .join('')
            .slice(0, 2)
            .toUpperCase() || '?';
    }

    function renderProjectOwner(project) {
        if (!projectOwnerAvatar) {
            return;
        }

        const owner = (project.collaborators || []).find(collaborator =>
            (collaborator.role || '').toLowerCase() === 'owner'
            || String(collaborator.userId) === String(project.userId));
        const ownerName = owner?.fullName || owner?.email || 'Project owner';
        projectOwnerAvatar.textContent = getInitials(ownerName);
        projectOwnerAvatar.title = ownerName;
        projectOwnerAvatar.setAttribute('aria-label', ownerName);
    }

    function renderTaskTags(tags) {
        return (tags || []).map(tag =>
            `<span class="kb-task-tag" style="--tag-color: ${escapeHtml(tag.color || '#6f42c1')}">${escapeHtml(tag.name)}</span>`
        ).join('');
    }

    function renderAssignees(task) {
        const assignees = task.assignees?.length
            ? task.assignees
            : task.assignedUserName
                ? [{ fullName: task.assignedUserName }]
                : [];

        if (!assignees.length) {
            return '<span>No assignee</span>';
        }

        const visibleAssignees = assignees.length > 3 ? assignees.slice(0, 2) : assignees;
        const avatars = visibleAssignees.map(assignee => {
            const name = assignee.fullName || assignee.email || 'Assignee';
            return `<span class="kb-assignee-avatar" title="${escapeHtml(name)}">${getInitials(name)}</span>`;
        });

        if (assignees.length > 3) {
            avatars.push(`<span class="kb-assignee-avatar is-overflow" title="${assignees.length - 2} more assignees">+${assignees.length - 2}</span>`);
        }

        return `<span class="kb-assignee-group">${avatars.join('')}</span>`;
    }

    function updateTaskBoard() {
        if (!boardContainer || !projectData) {
            return;
        }

        boardContainer.innerHTML = '';
        const columns = projectData.columns || [];
        const tasks = getFilteredTasks();

        columns.forEach((column, index) => {
            const columnTasks = tasks.filter(task => task.columnId === column.id);
            const columnElement = document.createElement('div');
            columnElement.className = 'kb-column rounded-3';
            columnElement.draggable = true;
            columnElement.innerHTML = `
                <div class="kb-header" data-column-id="${column.id}">
                    <input type="text" class="kb-title-input" value="${column.name}" disabled aria-label="Column name">
                    <div class="d-flex align-items-center gap-2">
                        <span class="kb-count rounded">${columnTasks.length}</span>
                        <div class="dropdown kb-column-dropdown">
                            <button class="btn p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end kb-project-selector-menu">
                                <li><button class="dropdown-item column-action-edit" type="button" data-column-id="${column.id}" data-column-name="${column.name}">Edit Name</button></li>
                                <li><button class="dropdown-item text-danger column-action-remove" type="button" data-column-id="${column.id}" data-column-name="${column.name}">Delete</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="kb-add-task rounded" role="button">
                    <i class="bi bi-plus-square me-2"></i>Add new task
                </div>
            `;
            columnElement.querySelector('.kb-add-task')?.addEventListener('click', showTaskItemModal);

            columnTasks.forEach(task => {
                const card = document.createElement('div');
                card.className = 'kb-card rounded mb-3';
                card.draggable = true;
                card.dataset.taskId = task.id;
                card.dataset.columnId = column.id;
                const dueDate = task.dueDate ? new Date(task.dueDate).toLocaleDateString() : 'No date';
                const assignees = renderAssignees(task);
                const taskTags = renderTaskTags(task.tags);
                card.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="kb-card-tags">${taskTags}</div>
                        <div class="dropdown kb-card-dropdown">
                            <button class="btn p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end kb-project-selector-menu">
                                <li><button class="dropdown-item task-action-view" type="button" data-task-id="${task.id}" data-task-title="${task.title}">View</button></li>
                                <li><button class="dropdown-item text-danger task-action-remove" type="button" data-task-id="${task.id}" data-task-title="${task.title}">Delete</button></li>
                            </ul>
                        </div>
                    </div>
                    <h6 class="mt-3 fw-bold">${task.title}</h6>
                    <div class="kb-card-footer mt-4">
                        <span>
                            <i class="bi bi-calendar3"></i>
                            ${dueDate}
                        </span>
                        ${assignees}
                    </div>
                `;
                card.addEventListener('dragstart', event => {
                    event.stopPropagation();
                    card.classList.add('dragging');
                    event.dataTransfer.setData('text/plain', task.id);
                    event.dataTransfer.effectAllowed = 'move';
                });

                card.addEventListener('dragend', () => {
                    card.classList.remove('dragging');
                    clearColumnDragState();
                });

                columnElement.appendChild(card);
            });

            columnElement.dataset.columnId = column.id;
            columnElement.addEventListener('dragstart', event => {
                if (event.target.closest('.kb-card, button, input, .dropdown')) {
                    event.preventDefault();
                    return;
                }

                columnElement.classList.add('column-dragging');
                event.dataTransfer.setData('application/x-kb-column', column.id);
                event.dataTransfer.effectAllowed = 'move';
            });

            columnElement.addEventListener('dragend', () => {
                columnElement.classList.remove('column-dragging');
                clearColumnDragState();
            });

            columnElement.addEventListener('dragover', event => {
                event.preventDefault();
                setActiveDropColumn(columnElement);
            });

            columnElement.addEventListener('dragleave', event => {
                if (event.relatedTarget && columnElement.contains(event.relatedTarget)) {
                    return;
                }
                if (columnDragCounters.get(columnElement) > 0) {
                    clearColumnDragState();
                }
            });

            columnElement.addEventListener('drop', async event => {
                event.preventDefault();
                setActiveDropColumn(null);
                const draggedColumnId = event.dataTransfer.getData('application/x-kb-column');
                if (draggedColumnId) {
                    if (String(draggedColumnId) !== String(column.id)) {
                        const placeAfter = event.clientX > columnElement.getBoundingClientRect().left + (columnElement.offsetWidth / 2);
                        await moveColumn(draggedColumnId, column.id, placeAfter);
                    }
                    return;
                }

                const taskId = event.dataTransfer.getData('text/plain');
                if (!taskId) {
                    return;
                }

                const card = document.querySelector(`[data-task-id="${taskId}"]`);
                if (!card || card.dataset.columnId === column.id) {
                    return;
                }

                await moveTaskToColumn(taskId, column.id);
            });

            boardContainer.appendChild(columnElement);
        });

        const addColumnElement = document.createElement('div');
        addColumnElement.className = 'kb-add-column rounded-3';
        addColumnElement.innerHTML = `
            <label class="form-label small fw-semibold" for="new-column-name">New Column</label>
            <div class="input-group input-group-sm">
                <input id="new-column-name" class="form-control" type="text" maxlength="100" placeholder="Column Name" aria-label="New Column Name">
                <button class="btn btn-action" type="button" id="add-column-button"><i class="bi bi-plus-lg me-1"></i>Add</button>
            </div>`;
        const newColumnNameInput = addColumnElement.querySelector('#new-column-name');
        const addColumnButton = addColumnElement.querySelector('#add-column-button');
        addColumnButton.addEventListener('click', () => addProjectColumn(newColumnNameInput, addColumnButton));
        newColumnNameInput.addEventListener('keydown', event => {
            if (event.key === 'Enter') {
                event.preventDefault();
                addProjectColumn(newColumnNameInput, addColumnButton);
            }
        });
        boardContainer.appendChild(addColumnElement);
        attachTaskActionHandlers();
        attachColumnActionHandlers();
    }

    async function addProjectColumn(input, button) {
        const name = input?.value.trim();
        if (!name || !projectData) {
            input?.focus();
            return;
        }

        button.disabled = true;
        try {
            const response = await fetch(`/api/projects/${projectData.id}/columns`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            });
            if (!response.ok) throw new Error('Unable to add column');

            const column = await response.json();
            projectData.columns = [...(projectData.columns || []), column];
            updateTaskBoard();
        } catch (error) {
            console.error(error);
            alert('Could not add the column. Please try again.');
            button.disabled = false;
        }
    }

    async function moveTaskToColumn(taskId, columnId) {
        if (!projectData) {
            return;
        }

        const response = await fetch(`/api/projects/${projectData.id}/tasks/${taskId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ columnId })
        });

        if (!response.ok) {
            console.error('Unable to move task to column', response.statusText);
            return;
        }

        await loadProjectData();
    }

    async function moveColumn(draggedColumnId, targetColumnId, placeAfter) {
        const columns = projectData?.columns || [];
        const sourceIndex = columns.findIndex(column => String(column.id) === String(draggedColumnId));
        const targetIndex = columns.findIndex(column => String(column.id) === String(targetColumnId));
        if (sourceIndex < 0 || targetIndex < 0) return;

        const reorderedColumns = [...columns];
        const [draggedColumn] = reorderedColumns.splice(sourceIndex, 1);
        let insertionIndex = reorderedColumns.findIndex(column => String(column.id) === String(targetColumnId));
        if (placeAfter) insertionIndex += 1;
        reorderedColumns.splice(insertionIndex, 0, draggedColumn);

        const response = await fetch(`/api/projects/${projectData.id}/columns/order`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ columnIds: reorderedColumns.map(column => column.id) })
        });
        if (!response.ok) {
            console.error('Unable to reorder columns', response.statusText);
            alert('Could not reorder the columns. Please try again.');
            return;
        }

        projectData.columns = reorderedColumns.map((column, position) => ({ ...column, position }));
        updateTaskBoard();
    }

    function showDeleteTaskModal(taskId, taskTitle) {
        if (!deleteTaskModal) {
            return;
        }

        pendingDeleteTaskId = taskId;
        if (deleteTaskBody) {
            deleteTaskBody.textContent = `Are you sure you want to delete the task "${taskTitle}"?`;
        }

        const modal = new bootstrap.Modal(deleteTaskModal);
        modal.show();
    }

    async function deleteTask() {
        if (!projectData || !pendingDeleteTaskId) {
            return;
        }

        const response = await fetch(`/api/projects/${projectData.id}/tasks/${pendingDeleteTaskId}`, {
            method: 'DELETE'
        });

        if (!response.ok) {
            console.error('Unable to delete task', response.statusText);
            alert('Task could not be deleted.');
            return;
        }

        const modalInstance = bootstrap.Modal.getInstance(deleteTaskModal);
        modalInstance?.hide();
        pendingDeleteTaskId = null;
        await loadProjectData();
    }

    function attachTaskActionHandlers() {
        if (!boardContainer) {
            return;
        }

        boardContainer.querySelectorAll('.task-action-remove').forEach(button => {
            button.removeEventListener('click', handleTaskRemoveClick);
            button.addEventListener('click', handleTaskRemoveClick);
        });

        boardContainer.querySelectorAll('.task-action-view').forEach(button => {
            button.removeEventListener('click', handleTaskViewClick);
            button.addEventListener('click', handleTaskViewClick);
        });
    }

    function attachColumnActionHandlers() {
        if (!boardContainer) return;

        boardContainer.querySelectorAll('.column-action-edit').forEach(btn => {
            btn.removeEventListener('click', handleColumnEditClick);
            btn.addEventListener('click', handleColumnEditClick);
        });

        boardContainer.querySelectorAll('.column-action-remove').forEach(btn => {
            btn.removeEventListener('click', handleColumnRemoveClick);
            btn.addEventListener('click', handleColumnRemoveClick);
        });
    }

    function handleColumnEditClick(event) {
        const btn = event.currentTarget;
        const columnId = btn.dataset.columnId;
        const header = document.querySelector(`.kb-header[data-column-id="${columnId}"]`);
        if (!header) return;

        const inputEl = header.querySelector('.kb-title-input');
        if (!inputEl) return;

        const originalName = inputEl.value;
        inputEl.disabled = false;
        inputEl.focus();
        const val = inputEl.value || '';
        inputEl.setSelectionRange(val.length, val.length);

        let isSaving = false;
        const finish = async (save) => {
            if (isSaving) return;
            inputEl.removeEventListener('blur', onBlur);
            inputEl.removeEventListener('keydown', onKeyDown);
            inputEl.disabled = true;
            if (!save) return;
            const newName = (inputEl.value || '').trim();
            if (!newName) {
                inputEl.value = originalName;
                return;
            }
            if (newName === originalName) return;
            if (!projectData?.id) return;

            isSaving = true;
            try {
                const response = await fetch(`/api/projects/${projectData.id}/columns/${columnId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: newName })
                });
                if (!response.ok) {
                    throw new Error(await response.text());
                }

                const updatedColumn = await response.json();
                const column = projectData.columns?.find(c => String(c.id) === String(columnId));
                if (column) column.name = updatedColumn.name;
                updateTaskBoard();
            } catch (error) {
                console.error(error);
                inputEl.value = originalName;
                alert(error.message || 'Unable to update the column name.');
            } finally {
                isSaving = false;
            }
        };

        const onBlur = () => finish(true);
        const onKeyDown = (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                finish(true);
            } else if (e.key === 'Escape') {
                e.preventDefault();
                inputEl.value = originalName;
                finish(false);
            }
        };

        inputEl.addEventListener('blur', onBlur);
        inputEl.addEventListener('keydown', onKeyDown);
    }

    let pendingDeleteColumnId = null;
    function handleColumnRemoveClick(event) {
        const btn = event.currentTarget;
        const columnId = btn.dataset.columnId;
        const columnName = btn.dataset.columnName || 'this column';
        pendingDeleteColumnId = columnId;
        if (deleteColumnBody) deleteColumnBody.textContent = `Are you sure you want to delete the column "${columnName}" and all its tasks?`;
        if (deleteColumnModal) {
            const modal = new bootstrap.Modal(deleteColumnModal);
            modal.show();
        } else {
            if (confirm(`Delete column "${columnName}" and all its tasks?`)) {
                performDeleteColumn(columnId);
            }
        }
    }

    async function performDeleteColumn(columnId) {
        if (projectData && projectData.columns) {
            projectData.columns = projectData.columns.filter(c => String(c.id) !== String(columnId));
            if (projectData.tasks) projectData.tasks = projectData.tasks.filter(t => String(t.columnId) !== String(columnId));
        }

        const colEl = document.querySelector(`.kb-column[data-column-id="${columnId}"]`);
        colEl?.remove();

        pendingDeleteColumnId = null;
        updateTaskBoard();
    }

    if (confirmDeleteColumnButton) {
        confirmDeleteColumnButton.addEventListener('click', async () => {
            const modalInstance = bootstrap.Modal.getInstance(deleteColumnModal);
            modalInstance?.hide();
            if (pendingDeleteColumnId) {
                await performDeleteColumn(pendingDeleteColumnId);
            }
        });
    }

    function handleTaskRemoveClick(event) {
        const button = event.currentTarget;
        const taskId = button.dataset.taskId;
        const taskTitle = button.dataset.taskTitle || 'this task';
        showDeleteTaskModal(taskId, taskTitle);
    }

    function handleTaskViewClick(event) {
        event.preventDefault();
        const button = event.currentTarget;
        const taskId = button.dataset.taskId;
        if (!projectData || !taskId) {
            return;
        }

        window.location.href = `/task/detail?projectId=${projectData.id}&taskId=${taskId}`;
    }

    async function loadProjectSelection() {
        if (!projectDropdownMenu) {
            return;
        }

        if (projectDropdownLoaded) {
            return;
        }

        const response = await fetch('/api/projects');
        if (!response.ok) {
            console.error('Unable to load projects');
            return;
        }

        const projects = await response.json();
        projectDropdownMenu.innerHTML = '';

        projects.forEach(project => {
            const item = document.createElement('li');
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'dropdown-item';
            button.textContent = project.name;
            button.addEventListener('click', () => {
                window.location.href = `/task?id=${project.id}`;
            });
            item.appendChild(button);
            projectDropdownMenu.appendChild(item);
        });

        projectDropdownLoaded = true;
    }

    async function openProjectSelection() {
        await loadProjectSelection();
    }

    function showCreateProjectModal() {
        if (!projectModalElement) {
            return;
        }

        const modal = new bootstrap.Modal(projectModalElement);
        modal.show();
    }

    function populateTaskModal() {
        if (!projectData) {
            return;
        }

        if (taskTitleInput) {
            taskTitleInput.value = '';
        }
        if (taskDescriptionInput) {
            taskDescriptionInput.value = '';
        }
        if (taskStartDateInput) {
            taskStartDateInput.value = '';
        }
        if (taskDueDateInput) {
            taskDueDateInput.value = '';
        }
        if (taskBoardTypeInput) {
            taskBoardTypeInput.value = projectData.name || 'Board';
        }

        if (taskColumnSelect) {
            taskColumnSelect.innerHTML = '';
            (projectData.columns || []).forEach(column => {
                const option = document.createElement('option');
                option.value = column.id;
                option.textContent = column.name;
                taskColumnSelect.appendChild(option);
            });
        }

        if (taskAssignedToSelect) {
            taskAssignedToSelect.innerHTML = '';
            (projectData.collaborators || []).forEach(collaborator => {
                const option = document.createElement('option');
                option.value = collaborator.userId;
                option.textContent = collaborator.fullName || collaborator.email || 'Collaborator';
                taskAssignedToSelect.appendChild(option);
            });
        }

        if (taskCategorySelect) {
            taskCategorySelect.innerHTML = '<option value="">-- Please Select --</option>';
            (projectData.tags || []).forEach(tag => {
                const option = document.createElement('option');
                option.value = tag.id;
                option.textContent = tag.name;
                taskCategorySelect.appendChild(option);
            });
        }
    }

    async function createTaskItem() {
        if (!projectData) {
            return;
        }

        const title = taskTitleInput?.value.trim() || '';
        const description = taskDescriptionInput?.value.trim() || '';
        const boardType = taskBoardTypeInput?.value.trim() || '';
        const columnId = taskColumnSelect?.value;
        const assignedUserIds = taskAssignedToSelect
            ? Array.from(taskAssignedToSelect.selectedOptions).map(option => option.value).filter(Boolean)
            : [];
        const startDate = taskStartDateInput?.value || null;
        const dueDate = taskDueDateInput?.value || null;
        const priority = taskPrioritySelect?.value || '';
        const tagId = taskCategorySelect?.value || null;

        if (!title) {
            alert('Please enter a task name.');
            return;
        }

        if (!description) {
            alert('Please enter a task description.');
            return;
        }

        if (!boardType) {
            alert('Board Type is required.');
            return;
        }

        if (!columnId) {
            alert('Please select a column.');
            return;
        }

        if (!startDate) {
            alert('Please select a start date.');
            return;
        }

        if (!dueDate) {
            alert('Please select a due date.');
            return;
        }

        if (!priority) {
            alert('Please select a priority.');
            return;
        }

        const payload = {
            title,
            description,
            boardType,
            columnId,
            assignedUserIds,
            startDate: startDate || null,
            dueDate: dueDate || null,
            priority,
            tagId: tagId || null,
        };

        try {
            const response = await fetch(`/api/projects/${projectData.id}/tasks`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(errorText || 'Unable to create task.');
            }

            const modalInstance = bootstrap.Modal.getInstance(taskItemModalElement);
            modalInstance?.hide();
            await loadProjectData();
        } catch (error) {
            console.error(error);
            alert(`Task could not be created. ${error.message}`);
        }
    }

    function showTaskItemModal() {
        if (!taskItemModalElement) {
            return;
        }

        populateTaskModal();
        const modal = new bootstrap.Modal(taskItemModalElement);
        modal.show();
    }

    async function deleteProject() {
        if (!projectData) {
            return;
        }

        const response = await fetch(`/api/projects/${projectData.id}`, {
            method: 'DELETE',
        });

        if (!response.ok) {
            console.error('Failed to delete project');
            return;
        }

        window.location.href = '/task';
    }

    const selectedCollaborators = new Map();
    let inviteSearchRequestId = 0;

    async function searchUsers(query) {
        const requestId = ++inviteSearchRequestId;
        inviteUserResults.innerHTML = '';
        inviteUserResults.hidden = false;

        if (!query.trim()) {
            const hint = document.createElement('button');
            hint.type = 'button';
            hint.className = 'list-group-item list-group-item-action disabled';
            hint.textContent = 'Start typing a name or email to find users.';
            inviteUserResults.appendChild(hint);
            return;
        }

        let users;
        try {
            const response = await fetch(`/api/users/search?q=${encodeURIComponent(query)}`);
            if (!response.ok) throw new Error('Failed to search users');
            users = await response.json();
        } catch (error) {
            if (requestId === inviteSearchRequestId) console.error(error);
            return;
        }
        if (requestId !== inviteSearchRequestId) return;
        let resultsFound = false;
        let allExcluded = true;

        users.forEach(user => {
            const normalizedUserId = String(user.id).toLowerCase();
            if (selectedCollaborators.has(user.id) || existingCollaboratorIds.has(normalizedUserId)) {
                return;
            }

            allExcluded = false;
            resultsFound = true;
            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'list-group-item list-group-item-action';
            item.textContent = `${user.name} (${user.email})`;
            item.addEventListener('click', () => addSelectedCollaborator(user));
            inviteUserResults.appendChild(item);
        });

        if (!resultsFound) {
            const empty = document.createElement('button');
            empty.type = 'button';
            empty.className = 'list-group-item list-group-item-action disabled';
            empty.textContent = allExcluded
                ? 'All matching users are already collaborators.'
                : 'No matching users found.';
            inviteUserResults.appendChild(empty);
        }
    }

    function renderSelectedCollaborators() {
        if (!selectedCollaboratorsContainer) {
            return;
        }

        selectedCollaboratorsContainer.innerHTML = '';

        selectedCollaborators.forEach(user => {
            const badge = document.createElement('span');
            badge.className = 'badge bg-primary rounded-pill d-inline-flex align-items-center gap-2';
            badge.textContent = `${user.name} (${user.email})`;
            badge.dataset.userId = user.id;

            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.className = 'btn-close btn-close-white btn-sm ms-2';
            removeButton.addEventListener('click', () => {
                selectedCollaborators.delete(user.id);
                renderSelectedCollaborators();
            });

            badge.appendChild(removeButton);
            selectedCollaboratorsContainer.appendChild(badge);
        });
    }

    function renderExistingCollaborators() {
        if (!existingCollaboratorsList || !projectData) {
            return;
        }

        existingCollaboratorsList.innerHTML = '';

        const collaborators = projectData.collaborators || [];
        if (!collaborators.length) {
            const empty = document.createElement('div');
            empty.className = 'text-muted small';
            empty.textContent = 'No existing collaborators in this project.';
            existingCollaboratorsList.appendChild(empty);
            return;
        }

        collaborators.forEach(collaborator => {
            const fullName = collaborator.fullName || collaborator.email || 'Collaborator';
            const item = document.createElement('div');
            item.className = 'list-group-item d-flex align-items-center gap-3';

            const avatar = document.createElement('div');
            avatar.className = 'kb-avatar d-flex align-items-center justify-content-center bg-secondary text-white';
            avatar.textContent = getInitials(fullName);

            const details = document.createElement('div');
            details.className = 'flex-grow-1';
            const name = document.createElement('div');
            name.className = 'fw-semibold';
            name.textContent = fullName;
            const email = document.createElement('div');
            email.className = 'text-muted small';
            email.textContent = collaborator.email || '';
            details.append(name, email);

            item.appendChild(avatar);
            item.appendChild(details);
            const isOwner = String(collaborator.userId) === String(projectData.userId)
                || String(collaborator.role || '').toLowerCase() === 'owner';
            if (isOwner) {
                const ownerLabel = document.createElement('span');
                ownerLabel.className = 'text-muted small ms-auto';
                ownerLabel.textContent = 'Owner';
                item.appendChild(ownerLabel);
            } else {
                const removeButton = document.createElement('button');
                removeButton.type = 'button';
                removeButton.className = 'btn-close ms-auto';
                removeButton.title = `Remove ${fullName}`;
                removeButton.setAttribute('aria-label', `Remove ${fullName}`);
                removeButton.addEventListener('click', () => removeCollaborator(collaborator, removeButton));
                item.appendChild(removeButton);
            }
            existingCollaboratorsList.appendChild(item);
        });
    }

    async function removeCollaborator(collaborator, button) {
        if (!projectData || !collaborator?.userId) return;

        const fullName = collaborator.fullName || collaborator.email || 'this collaborator';
        const confirmed = await window.showConfirm({
            title: 'Remove collaborator',
            message: `Remove ${fullName} from this project?`,
            confirmText: 'Remove'
        });
        if (!confirmed) return;

        button.disabled = true;
        try {
            const response = await fetch(`/api/projects/${projectData.id}/collaborators/${encodeURIComponent(collaborator.userId)}`, {
                method: 'DELETE'
            });
            if (!response.ok) {
                throw new Error((await response.text()) || 'Unable to remove collaborator.');
            }

            projectData.collaborators = (projectData.collaborators || [])
                .filter(item => String(item.userId) !== String(collaborator.userId));
            existingCollaboratorIds.delete(String(collaborator.userId).toLowerCase());
            button.closest('.list-group-item')?.remove();

            // Refresh task assignments in the background after the immediate UI update.
            loadProjectData();
        } catch (error) {
            console.error(error);
            alert(error.message || 'Could not remove this collaborator.');
            button.disabled = false;
        }
    }

    function isExistingProjectCollaborator(userId) {
        return existingCollaboratorIds.has(userId);
    }

    function addSelectedCollaborator(user) {
        if (selectedCollaborators.has(user.id)) {
            return;
        }

        selectedCollaborators.set(user.id, user);
        renderSelectedCollaborators();
        inviteUserResults.innerHTML = '';
        inviteUserSearch.value = '';
    }

    function showInviteModal() {
        if (!inviteCollaboratorModal) {
            return;
        }

        const modal = new bootstrap.Modal(inviteCollaboratorModal);
        modal.show();

        renderSelectedCollaborators();
        renderExistingCollaborators();
    }

    async function submitInviteSelection() {
        if (!selectedCollaborators.size) {
            alert('Select at least one collaborator before submitting.');
            return;
        }

        if (!inviteConfirmModal || !inviteConfirmBody) {
            return;
        }

        const names = Array.from(selectedCollaborators.values()).map(user => user.name);
        inviteConfirmBody.textContent = `Invite ${names.length} collaborator(s): ${names.join(', ')}?`;

        const modal = new bootstrap.Modal(inviteConfirmModal);
        modal.show();
    }

    async function confirmInvite() {
        if (!projectData || !selectedCollaborators.size || confirmInviteButton.disabled) {
            return;
        }

        confirmInviteButton.disabled = true;
        try {
            const selectedUsers = Array.from(selectedCollaborators.values());
            const results = await Promise.all(selectedUsers.map(user =>
                $.ajax({
                    url: `/api/projects/${projectData.id}/collaborators`,
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ userId: user.id, role: 'member' })
                }).then(() => ({ user, success: true }))
                  .catch((jqXHR, textStatus, errorThrown) => ({
                      user,
                      success: false,
                      error: jqXHR?.responseText || errorThrown || textStatus || 'Unknown error'
                  }))
            ));

            const failed = results.filter(result => !result.success);
            const successful = results.filter(result => result.success);

            const inviteConfirmInstance = bootstrap.Modal.getInstance(inviteConfirmModal);
            inviteConfirmInstance?.hide();

            if (successful.length) {
                successful.forEach(result => selectedCollaborators.delete(result.user.id));
                renderSelectedCollaborators();
            }

            if (failed.length) {
                const errorMessages = failed.map(result => `${result.user.name}: ${result.error}`);
                alert(`Some collaborators could not be invited.\n${errorMessages.join('\n')}`);
                return;
            }

            const inviteModalInstance = bootstrap.Modal.getInstance(inviteCollaboratorModal);
            inviteModalInstance?.hide();
            selectedCollaborators.clear();

            await loadProjectData();
        } finally {
            confirmInviteButton.disabled = false;
        }
    }

    function showDeleteModal() {
        if (!deleteProjectModal) {
            return;
        }

        const modal = new bootstrap.Modal(deleteProjectModal);
        modal.show();
    }

    if (taskSearchInput) {
        taskSearchInput.addEventListener('input', event => {
            searchTerm = event.target.value.trim().toLocaleLowerCase();
            updateTaskBoard();
        });
    }

    if (filterButton) {
        filterButton.addEventListener('click', () => {
            renderTagFilterMenu(projectData?.tags || []);
        });
    }

    if (clearTagFilterButton) {
        clearTagFilterButton.addEventListener('click', () => {
            selectedTagIds.clear();
            renderProject(projectData);
            updateTaskBoard();
        });
    }

    if (deleteProjectButton) {
        deleteProjectButton.addEventListener('click', showDeleteModal);
    }

    if (confirmDeleteProjectButton) {
        confirmDeleteProjectButton.addEventListener('click', deleteProject);
    }

    if (confirmDeleteTaskButton) {
        confirmDeleteTaskButton.addEventListener('click', deleteTask);
    }

    if (newProjectButton) {
        newProjectButton.addEventListener('click', showCreateProjectModal);
    }

    if (inviteButton) {
        inviteButton.addEventListener('click', showInviteModal);
    }

    if (inviteSubmitButton) {
        inviteSubmitButton.addEventListener('click', submitInviteSelection);
    }

    if (confirmInviteButton) {
        confirmInviteButton.addEventListener('click', confirmInvite);
    }

    if (saveTaskButton) {
        saveTaskButton.addEventListener('click', createTaskItem);
    }

    if (projectNameDisplay) {
        projectNameDisplay.addEventListener('click', openProjectSelection);
    }

    if (inviteUserSearch) {
        inviteUserSearch.addEventListener('input', event => {
            searchUsers(event.target.value);
        });
        inviteUserSearch.addEventListener('blur', () => {
            window.setTimeout(() => {
                if (inviteUserResults.contains(document.activeElement)) {
                    return;
                }

                inviteSearchRequestId += 1;
                inviteUserResults.innerHTML = '';
                inviteUserResults.hidden = true;
            }, 0);
        });
    }

    document.addEventListener('DOMContentLoaded', () => { loadProjectData(); attachColumnActionHandlers(); });
</script>
