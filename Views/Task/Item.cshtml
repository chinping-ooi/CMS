<style>
    .page-bg {
        background: #f5f6f8;
        min-height: 100vh;
        padding: 30px;
    }


    .task-container {
        background: #fff;
        border-radius: 10px;
        padding: 20px;
    }


    .task-title {
        text-align: center;
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 25px;
    }


    .task-label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #70809a;
        text-transform: uppercase;
        margin-bottom: 6px;
    }


    .task-input {
        height: 42px;
    }


    .task-description {
        height: 460px;
        resize: none;
    }


    .task-box {
        margin-bottom: 15px;
    }


    .task-button-add {
        background: #143b8f;
        border: 1px solid #143b8f;
        color: #fff;
        height: 42px;
    }


    .task-button-add:hover {
        background: #0d2c6b;
        color: #fff;
    }


    .task-button-delete {
        background: white;
        border: 1px solid #ef4444;
        color: #ef4444;
        height: 42px;
    }


    .task-button-done {
        background: #2563eb;
        color: #fff;
        border: none;
        height: 42px;
        padding: 0 35px;
    }


    .task-attachment {
        height: 90px;
        border: 2px dashed #d5dce7;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9aa4b2;
    }


    .task-footer {
        margin-top: 20px;
    }


    .task-close {
        color: #667085;
        text-decoration: none;
    }
</style>


<div class="page-bg">


    <div class="container-fluid">


        <div class="task-container">


            <h4 class="task-title">
                IN PROGRESS - Create New Task
            </h4>



            <!-- Task Name -->
            <div class="task-box">

                <input class="form-control task-input"
                       placeholder="{MODULE}-{TASK}-{VERSION} E.G. EMPLOYEE-BUG ON DATA-V1.20.4">

            </div>





            <div class="row g-4">


                <!-- LEFT -->
                <div class="col-lg-6">


                    <label class="task-label">
                        Add a Description
                    </label>


                    <textarea class="form-control task-description"></textarea>


                </div>






                <!-- RIGHT -->
                <div class="col-lg-6">


                    <div class="row g-3">


                        <div class="col-md-6">


                            <label class="task-label">
                                Board Type
                            </label>


                            <input class="form-control task-input" value="Testing" readonly>


                        </div>





                        <div class="col-md-6">


                            <label class="task-label">
                                Column
                            </label>


                            <input class="form-control task-input" value="IN PROGRESS" readonly>


                        </div>





                        <div class="col-12">


                            <label class="task-label">
                                Assigned To
                            </label>


                            <select class="form-select task-input">


                                <option>
                                    Unassigned
                                </option>


                            </select>


                        </div>






                        <div class="col-12">


                            <label class="task-label">
                                Priority
                            </label>


                            <select class="form-select task-input">


                                <option>
                                    Medium
                                </option>


                            </select>


                        </div>






                        <div class="col-md-6">


                            <label class="task-label">
                                Start Date
                            </label>


                            <input type="date" class="form-control task-input">


                        </div>





                        <div class="col-md-6">


                            <label class="task-label">
                                Due Date
                            </label>


                            <input type="date" class="form-control task-input">


                        </div>







                        <div class="col-12">


                            <div class="row align-items-end">


                                <div class="col-md-7">


                                    <label class="task-label">
                                        Category
                                    </label>


                                    <select class="form-select task-input">


                                        <option>
                                            -- Please Select --
                                        </option>


                                    </select>


                                </div>





                                <div class="col-md-5 text-end">


                                    <button class="btn task-button-delete">

                                        <i class="bi bi-trash"></i>
                                        Delete

                                    </button>


                                    <button class="btn task-button-add ms-2">


                                        <i class="bi bi-plus-circle"></i>
                                        Add


                                    </button>


                                </div>


                            </div>


                        </div>







                        <div class="col-12">


                            <label class="task-label">
                                Attachments
                            </label>


                            <div class="task-attachment">

                                Drop files here

                            </div>


                        </div>





                    </div>


                </div>


            </div>






            <!-- FOOTER -->

            <div class="d-flex justify-content-between align-items-center task-footer">


                <a href="#" class="task-close">

                    <i class="bi bi-x-lg"></i>
                    Close

                </a>




                <button class="btn task-button-done">

                    Done

                </button>



            </div>



        </div>


    </div>


</div>
