@model IEnumerable<Customer>

@{
    int row = 1;
}

@foreach (var item in Model)
{
    <tr id="row-@item.Customer_Id">
        <td class="ps-4 fw-semibold text-secondary">
            #@row
        </td>
        <td>
            <span class="fw-bold text-dark customer-name">
                @item.Name
            </span>
        </td>
        <td>
            <span class="text-muted">
                @(string.IsNullOrEmpty(item.Email) ? "-" : item.Email)
            </span>
        </td>
        <td>
            <span class="text-muted">
                @(string.IsNullOrEmpty(item.Phone) ? "-" : item.Phone)
            </span>
        </td>
        <td>
            <span class="badge @(item.Customer_Status == "Active"
                    ? "bg-success bg-opacity-10 text-success"
                    : item.Customer_Status == "Pending"
                        ? "bg-warning bg-opacity-10 text-warning"
                        : "bg-secondary bg-opacity-10 text-secondary")
                fw-semibold px-2 py-1">
                @item.Customer_Status
            </span>
        </td>


        <td class="text-end pe-4">
            <button class="btn btn-sm btn-action fw-semibold" onclick="openEditModal(@item.Customer_Id)">
                <i class="fa-regular fa-pen-to-square"></i>
            </button>
            <button type="button" class="btn btn-sm btn-delete fw-semibold"
                    onclick="deleteCustomer(@item.Customer_Id)">
                <i class="fa-solid fa-trash-can"></i>
            </button>
        </td>
    </tr>
    row++;
}