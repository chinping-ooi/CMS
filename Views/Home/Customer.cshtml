@using System.Text.Encodings.Web
@model IEnumerable<CMS.Models.Customer>

@{
    ViewData["Title"] = "Customer Directory";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1 text-dark">Customer Directory</h3>
            <p class="text-muted mb-0">Manage customer records, add new profiles, modify details, and delete entries.
            </p>
        </div>
        <div>
            <button class="btn btn-sm btn-action fw-semibold" data-bs-toggle="modal" data-bs-target="#addModal">
                + New Customer
            </button>
        </div>
    </div>

    <div class="card border-0">
        <div
            class="card-header bg-white py-3 border rounded-0 d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <div class="input-group" style="max-width: 380px;">
                <span class="input-group-text bg-light border-end-0">
                    <i class="fa fa-search text-muted"></i>
                </span>
                <input type="text" id="searchInput" class="form-control bg-light border-start-0 ps-0"
                       placeholder="Search by name, email, city...">
            </div>
            <div class="text-muted small">
                Total Customers: @(Model?.Count() ?? 0)
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle rounded-0 border" id="customerTable">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">ID</th>
                            <th scope="col">Company Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Phone</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="customerTableBody">
                        @if (Model != null && Model.Any()){
                            int row = 1;
                            @foreach (var item in Model)
                            {
                                <tr id="row-@item.Customer_Id">
                                    <td class="ps-4 fw-semibold text-secondary">#@row</td>
                                    <td>
                                        <span class="fw-bold text-dark customer-name">@item.Name</span>
                                    </td>
                                    <td>
                                        <span class="text-muted">@(string.IsNullOrEmpty(item.Email) ? "-" : item.Email)</span>
                                    </td>
                                    <td>
                                        <span class="text-muted">@(string.IsNullOrEmpty(item.Phone) ? "-" : item.Phone)</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-action fw-semibold"
                                                onclick="openEditModal(@item.Customer_Id)">
                                            <i class="fa-regular fa-pen-to-square"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-delete fw-semibold"
                                                onclick="deleteCustomer(@item.Customer_Id)">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </td>
                                </tr>
                                row++;
                            }
                        }
                        else {
                            <tr id="noDataRow">
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fa fa-people fs-1 d-block text-secondary mb-2"></i>
                                    No customers found. Click "Add Customer" to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header">
                <h5 class="modal-title" id="addModalLabel">
                    Add New Customer
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addCustomerForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="Created_By" value="Admin" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Company Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="Name" class="form-control" placeholder="Acme Corporation" required
                                   data-validation-message="Company name is required.">
                            <div class="invalid-feedback mt-1">Company name is required.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span>
                            </label>
                            <input type="email" name="Email" class="form-control" placeholder="contact@example.com"
                                   required data-validation-message="Email address is required.">
                            <div class="invalid-feedback mt-1">Email address is required.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone Number <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="Phone" class="form-control" placeholder="+1 555-0199" required
                                   data-validation-message="Phone number is required.">
                            <div class="invalid-feedback mt-1">Phone number is required.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Country</label>
                            <input type="text" name="Country" class="form-control" placeholder="United States">
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Street Address</label>
                            <input type="text" name="Address" class="form-control"
                                   placeholder="123 Market Street, Suite 400">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">City</label>
                            <input type="text" name="City" class="form-control" placeholder="San Francisco">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">State / Province</label>
                            <input type="text" name="State" class="form-control" placeholder="CA">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Postal Code</label>
                            <input type="text" name="Postal_Code" class="form-control" placeholder="94105">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel px-4 fw-semibold"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-action px-4 fw-semibold">
                        Submit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">
                    Modify Customer
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editCustomerForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="Customer_Id" id="customer_id" />                    
                    <input type="hidden" name="Created_By" id="created_by" />
                    <input type="hidden" name="Created_Date" id="created_date" />
                    <input type="hidden" name="Created_Loc" id="created_loc" />


                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Company Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="Name" id="name" class="form-control" required
                                   data-validation-message="Company name is required.">
                            <div class="invalid-feedback mt-1">Company name is required.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span>
                            </label>
                            <input type="email" name="Email" id="email" class="form-control" required
                                   data-validation-message="Email address is required.">
                            <div class="invalid-feedback mt-1">Email address is required.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input type="text" name="Phone" id="phone" class="form-control" required
                                   data-validation-message="Phone number is required.">
                            <div class="invalid-feedback mt-1">Phone number is required.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Country</label>
                            <input type="text" name="Country" id="country" class="form-control">
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Street Address</label>
                            <input type="text" name="Address" id="address" class="form-control">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">City</label>
                            <input type="text" name="City" id="city" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">State / Province</label>
                            <input type="text" name="State" id="state" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Postal Code</label>
                            <input type="text" name="Postal_Code" id="postal_code" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel px-4 fw-semibold"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-action px-4 fw-semibold">
                        Submit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>        
        $(document).ready(function () {
            loadCustomers();

            $('#searchInput').on('keyup', function () {
                var term = $(this).val().toLowerCase();
                $('#customerTableBody tr:not(#noDataRow)').each(function () {
                    var rowText = $(this).text().toLowerCase();
                    $(this).toggle(rowText.indexOf(term) >= 0);
                });
            });

            if (window.formValidation) {
                window.formValidation.setup('addCustomerForm');
                window.formValidation.setup('editCustomerForm');
            }
        });

        function loadCustomers() {
            $.ajax({
                type: "GET",
                url: "/api/customer",
                success: function (customers) {
                    let tbody = $("#customerTableBody");
                    tbody.empty();
                    if (customers.length === 0) {
                        tbody.append(`
                            <tr id="noDataRow">
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fa fa-people fs-1 d-block text-secondary mb-2"></i>
                                    No customers found. Click "Add Customer" to create one.
                                </td>
                            </tr>
                        `);
                        return;
                    }
                    $.each(customers, function (index, item) {
                        tbody.append(`
                            <tr id="row-${item.customer_Id}">
                                <td class="ps-4 fw-semibold text-secondary">
                                    #${index + 1}
                                </td>
                                <td>
                                    <span class="fw-bold text-dark customer-name">
                                        ${item.name}
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted">
                                        ${item.email ?? "-"}
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted">
                                        ${item.phone ?? "-"}
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-action fw-semibold"
                                            onclick="openEditModal(${item.customer_Id})">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-delete fw-semibold"
                                            onclick="deleteCustomer(${item.customer_Id})">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </td>
                            </tr>
                        `);
                    });
                },
                error: function (xhr) {
                    $("#customerTableBody").html(`
                        <tr>
                            <td colspan="5" class="text-center py-5 text-danger">
                                Failed to load customers.
                            </td>
                        </tr>
                    `);
                    window.notify(
                        "danger",
                        "Load Failed",
                        "Unable to load customer data."
                    );
                }
            });
        }

        function deleteCustomer(id) {
            if (!id) return;

            window.showConfirm({
                title: 'Delete Customer',
                message: 'Are you sure you want to delete this customer?',
                detail: 'This action cannot be undone.',
                confirmText: 'Confirm'
            }).then(function (confirmed) {
                if (!confirmed) return;
                
                $.ajax({
                    type: 'DELETE',
                    url: `/api/customer/${id}`,
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function () {
                        window.notify(
                            "danger", 
                            "Delete Failed", 
                            "Customer has been deleted successfully."
                        );
                        loadCustomers();
                    },
                    error: function () {
                        window.notify(
                            "danger", 
                            "Delete Failed", 
                            "Unable to delete customer. Please try again."
                        );
                    }
                });
            });
        }

        function openEditModal(id) {
            if (!id) return;

            $.ajax({
                type: 'GET',
                url: `/api/customer/${id}`,
                dataType: 'json',
                success: function (customer) {
                    const form = document.getElementById("editCustomerForm");

                    Object.entries(customer).forEach(([key, value]) => {
                        $("#" + key.toLowerCase()).val(value ?? "");
                    });

                    bootstrap.Modal.getOrCreateInstance(document.getElementById("editModal")).show();
                },
                error: function () {
                    window.notify(
                        "danger", 
                        "Load failed", 
                        "Unable to load customer. Please try again."
                    );
                }
            });
        }

        $("#editCustomerForm").submit(function(e) {
            e.preventDefault();

            const id = $("#customer_id").val();
            if (!id) return;

            const formData = Object.fromEntries(
                new FormData(this).entries()
            );

            $.ajax({
                type: "PUT",
                url: `/api/customer/${id}`,
                contentType: "application/json; charset=utf-8",                
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(formData),
                success: function () {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById("editModal")).hide();
                    window.notify(
                        "success", 
                        "Customer Updated", 
                        "Customer details have been updated successfully."
                    );
                    loadCustomers();
                },
                error: function (xhr) {
                    window.notify(
                        "danger", 
                        "Update Failed", 
                        "Unable to update customer. Please try again."
                    );
                }
            });
        });

        $("#addCustomerForm").submit(function(e) {
            e.preventDefault();

            const formData = Object.fromEntries(
                new FormData(this).entries()
            );

            console.log(formData)

            $.ajax({
                type: "POST",
                url: `/api/customer`,
                contentType: "application/json; charset=utf-8",                
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(formData),
                success: function () {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById("addModal")).hide();
                    window.notify(
                        "success", 
                        "Customer Created", 
                        "Customer details have been created successfully."
                    );
                    loadCustomers();
                },
                error: function (xhr) {
                    window.notify(
                        "danger", 
                        "Create Failed", 
                        "Unable to create customer. Please try again."
                    );
                }
            });
        });
    </script>
}
