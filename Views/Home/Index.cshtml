@{
    ViewData["Title"] = "Home Page";
}

<div class="container">

    <!-- Summary Cards -->
    <div class="row g-4 mb-5">

        <div class="col-md-3">
            <div class="card shadow-sm border-1 bg-white h-100">
                <div class="card-body text-center">
                    <h6>Total Customers</h6>
                    <h2 class="fw-bold">1,250</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-1 bg-white h-100">
                <div class="card-body text-center">
                    <h6>Active Customers</h6>
                    <h2 class="fw-bold">980</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-1 bg-white h-100">
                <div class="card-body text-center">
                    <h6>Customer Revenue</h6>
                    <h2 class="fw-bold">$865,000</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-1 bg-white h-100">
                <div class="card-body text-center">
                    <h6>Potential Revenue</h6>
                    <h2 class="fw-bold">$1,250,000</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="row">

        <!-- Top 5 Customers -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light border">
                    <h5 class="mb-0">
                        <i class="fa fa-trophy me-2"></i>Top 5 Customers
                    </h5>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle rounded-0 border">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Customer</th>
                                <th>Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>ABC Corporation</td>
                                <td>$180,000</td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>Global Tech Ltd</td>
                                <td>$150,000</td>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td>Sunrise Trading</td>
                                <td>$132,000</td>
                            </tr>
                            <tr>
                                <td>4</td>
                                <td>Ocean Logistics</td>
                                <td>$118,000</td>
                            </tr>
                            <tr>
                                <td>5</td>
                                <td>Prime Solutions</td>
                                <td>$95,000</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Potential Revenue Customers -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light border">
                    <h5 class="mb-0">
                        <i class="fa fa-chart-line me-2"></i>Top 5 Potential Revenue
                    </h5>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle rounded-0 border">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Customer</th>
                                <th>Potential</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>Future Holdings</td>
                                <td>$250,000</td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>BlueSky Group</td>
                                <td>$220,000</td>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td>NextGen Industries</td>
                                <td>$190,000</td>
                            </tr>
                            <tr>
                                <td>4</td>
                                <td>Innovate Sdn Bhd</td>
                                <td>$165,000</td>
                            </tr>
                            <tr>
                                <td>5</td>
                                <td>Vision Enterprise</td>
                                <td>$140,000</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <!-- Navigation -->
    <div class="text-center mt-4">
        <a asp-route="customer" class="btn btn-primary btn-lg px-5">
            <i class="fa fa-users me-2"></i>Manage Customers
        </a>
    </div>

</div>