@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-5">
                    <h1 class="display-4 text-primary">404</h1>
                    <h2 class="mb-3">Page not found</h2>
                    <p class="text-muted mb-4">The page you are looking for does not exist or has been moved.</p>
                    <a asp-controller="Task" asp-action="Index" class="btn btn-primary px-4">Go to Tasks</a>
                </div>
            </div>
        </div>
    </div>
</div>
